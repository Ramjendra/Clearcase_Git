        <mxCell id="ag4" parent="zone_pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0d2137;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=8;" value="④ GitConversionAgent" vertex="1">
          <mxGeometry height="44" width="860" x="20" y="638" as="geometry" />
        </mxCell>
        <mxCell id="ag4_d" parent="zone_pipeline" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="• Injects .gitattributes + .gitignore as commit #1 (conditional on generate_gitattributes / generate_gitignore flags)&#xa;• Streams all commits via git fast-import (bulk, no checkout overhead); forks new branches from default branch tip&#xa;• Wires merge parents for CC merge arrows; multi-VOB tag deduplication (written_tags set prevents duplicate fast-import refs)&#xa;• Attaches CC labels as annotated git tags; outputs git_output/ repo" vertex="1">
          <mxGeometry height="52" width="860" x="20" y="684" as="geometry" />
        </mxCell>
        <mxCell id="arr45" edge="1" parent="zone_pipeline" source="ag4" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fillColor=#d6b656;strokeColor=#d6b656;fontStyle=1;" target="ag5" value="git repo (fast-import)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

