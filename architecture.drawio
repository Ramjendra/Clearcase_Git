        <!-- ═══════════════════════════════════════════════════════ 5-Agent Pipeline Zone -->
        <mxCell id="zone_pipeline" parent="1" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;rounded=1;arcSize=4;" value="5-Agent Migration Pipeline" vertex="1">
