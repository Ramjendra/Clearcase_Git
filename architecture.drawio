        <!-- Agent 1 -->
        <mxCell id="ag1" parent="zone_pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0d2137;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=8;" value="① DiscoveryAgent" vertex="1">
          <mxGeometry height="44" width="860" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ag1_d" parent="zone_pipeline" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="• Calls cleartool lsvob / lstype brtype / lstype lbtype / find&#xa;• Maps every VOB → branches + labels + element paths; multi-VOB each discovered independently&#xa;• UCM: lists streams + baselines + activities (baseline_tag used as start point)&#xa;• Outputs: workspace/discovery.json" vertex="1">
          <mxGeometry height="52" width="860" x="20" y="96" as="geometry" />
        </mxCell>
        <mxCell id="arr12" edge="1" parent="zone_pipeline" source="ag1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;fillColor=#d6b656;strokeColor=#d6b656;fontStyle=1;" target="ag2" value="discovery.json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Agent 2 -->
        <mxCell id="ag2" parent="zone_pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0d2137;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=8;" value="② HistoryAgent" vertex="1">
          <mxGeometry height="44" width="860" x="20" y="168" as="geometry" />
        </mxCell>
        <mxCell id="ag2_d" parent="zone_pipeline" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="• Calls cleartool lshistory -minor -fmt for every element (9 timestamp formats supported)&#xa;• Groups versions → git commits by (branch, author, comment, 60-sec window); batch_size controls chunk size&#xa;• UCM mode: one activity = one commit; resolves merge arrows → merge parents&#xa;• rmname / rmelem / destroy-version events → deleted file markers; Outputs: workspace/commits.json" vertex="1">
          <mxGeometry height="52" width="860" x="20" y="214" as="geometry" />
        </mxCell>
        <mxCell id="arr23" edge="1" parent="zone_pipeline" source="ag2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;fillColor=#d6b656;strokeColor=#d6b656;fontStyle=1;" target="ag3" value="commits.json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Agent 3 -->
        <mxCell id="ag3" parent="zone_pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#0d2137;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=8;" value="③ ExtractorAgent" vertex="1">
          <mxGeometry height="44" width="860" x="20" y="286" as="geometry" />
        </mxCell>
        <mxCell id="ag3_d" parent="zone_pipeline" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="• Parallel pre-fetch via ThreadPoolExecutor (max_workers config); cleartool get → raw bytes per version; version_cache/&#xa;• Detects binary vs text (magic bytes: ELF/AR/PDF/ZIP/PNG/JPEG/GIF/CLASS/Mach-O); routes C/C++/Makefile/CMake/Pro*C through CFileAgent&#xa;• Applies LFS: pattern match + size threshold → pointer file + blob store; deleted markers skip content fetch&#xa;• Outputs: workspace/enriched_commits.json  (base64 content inline)" vertex="1">
          <mxGeometry height="52" width="860" x="20" y="332" as="geometry" />
        </mxCell>

        <!-- CFileAgent box — expanded to 2 rows -->
