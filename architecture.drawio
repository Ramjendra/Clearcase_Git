          <mxGeometry height="44" width="860" x="20" y="752" as="geometry" />
        </mxCell>
        <mxCell id="ag5_d" parent="zone_pipeline" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" value="• GitHub REST API: create repo (private/public/internal); set branch protection on default branch&#xa;• Auth: SSH key (git@github.com — use_ssh=true, no token needed) OR HTTPS with GITHUB_TOKEN&#xa;• Custom SSH key path via ssh_key_path; GIT_SSH_COMMAND injected for non-default keys&#xa;• git push --all --tags; runs upload_lfs.sh for LFS blobs; creates migration summary Issue on GitHub" vertex="1">
          <mxGeometry height="52" width="860" x="20" y="798" as="geometry" />
        </mxCell>
        <mxCell id="resume_bar" parent="zone_pipeline" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;fontStyle=2;" value="Resume-on-failure: each agent persists state to workspace/&lt;name&gt;_state.json  •  --skip-to {history|extract|convert|publish}  •  version_cache/ survives restarts" vertex="1">
          <mxGeometry height="22" width="860" x="20" y="858" as="geometry" />
