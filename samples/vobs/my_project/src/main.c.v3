 *
 * CORNER CASE: hard-coded view-root path that crept in via copy-paste
 * from a developer's local environment. Migration tool rewrites these.
 *
 * $Header: /vobs/my_project/src/main.c@@/main/3  2024-01-20.14:00:00  mary.jones  $
 * $Revision: 3 $
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>

/*
 * CORNER CASE: @@-extended include path accidentally checked in.
 * Correct form: #include "config.h"
 */
#include "config.h@@/main/3"
#include "utils.h"

/*
 * CORNER CASE: developer hard-coded their local view path in a comment
 * (and in a string below). Migration tool normalises these.
 *
 * Original path in developer's env:
 *   /view/mary_dev_view/vobs/my_project/data/default.cfg
 */
#define DEFAULT_CFG_PATH "/view/mary_dev_view/vobs/my_project/data/default.cfg"

/* ---- watchdog ---------------------------------------------------------- */
static volatile int g_running = 1;

static void *watchdog_thread(void *arg)
{
    (void)arg;
    while (g_running) {
        /* kick hardware watchdog register */
        /* hw_watchdog_kick(); */
        struct timespec ts = { 0, HEARTBEAT_INTERVAL_MS * 1000000L };
        nanosleep(&ts, NULL);
    }
    return NULL;
}

/* ---- arg parse --------------------------------------------------------- */
typedef struct {
    int   debug;
    int   verbose;
    char *infile;
    char *cfg_file;
} app_args_t;

static int parse_args(int argc, char *argv[], app_args_t *out)
{
    int i;
    out->debug    = 0;
    out->verbose  = 0;
    out->infile   = NULL;
    out->cfg_file = DEFAULT_CFG_PATH;   /* <-- view-root path (corner case) */

    for (i = 1; i < argc; i++) {
        if (str_compare(argv[i], "-d") == 0) {
            out->debug = 1;
        } else if (str_compare(argv[i], "-v") == 0) {
            out->verbose = 1;
        } else if (str_compare(argv[i], "-c") == 0 && i + 1 < argc) {
            out->cfg_file = argv[++i];
        } else if (argv[i][0] != '-') {
            out->infile = argv[i];
        } else {
            fprintf(stderr, "Unknown option: %s\n", argv[i]);
            return -1;
        }
    }
    return out->infile ? 0 : -1;
}

/* ---- main -------------------------------------------------------------- */
int main(int argc, char *argv[])
{
    app_args_t  args;
    pthread_t   wd_tid;

    if (parse_args(argc, argv, &args) != 0) {
        fprintf(stderr, "Usage: %s [-d] [-v] [-c cfg] <input>\n", argv[0]);
        return 1;
    }

    TRACE_ENTER("main");
    DBG_PRINT("cfg=%s input=%s", args.cfg_file, args.infile);

    pthread_create(&wd_tid, NULL, watchdog_thread, NULL);

    printf("Processing: %s\n", args.infile);

    g_running = 0;
    pthread_join(wd_tid, NULL);

    TRACE_EXIT("main");
    return 0;
}
