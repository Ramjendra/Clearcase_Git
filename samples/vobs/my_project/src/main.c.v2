#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "config.h"
#include "utils.h"

static void print_usage(const char *prog)
{
    fprintf(stderr, "Usage: %s [-d] [-v] <input_file>\n", prog);
    fprintf(stderr, "  -d   enable debug output\n");
    fprintf(stderr, "  -v   print version and exit\n");
}

int main(int argc, char *argv[])
{
    int   debug   = 0;
    int   i;
    char *infile  = NULL;

    for (i = 1; i < argc; i++) {
        if (str_compare(argv[i], "-d") == 0) {
            debug = 1;
        } else if (str_compare(argv[i], "-v") == 0) {
            printf("%s version %s\n", APP_NAME, APP_VERSION);
            return 0;
        } else if (argv[i][0] != '-') {
            infile = argv[i];
        } else {
            print_usage(argv[0]);
            return 1;
        }
    }

    if (!infile) {
        print_usage(argv[0]);
        return 1;
    }

    if (debug) {
        DBG_PRINT("Starting %s with input: %s", APP_NAME, infile);
    }

    printf("Processing: %s\n", infile);
    return 0;
}
