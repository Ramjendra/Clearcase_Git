#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include "config.h"
#include "utils.h"

/* DEFAULT_CFG_PATH now comes from the build system, not hard-coded */
#ifndef DEFAULT_CFG_PATH
  #define DEFAULT_CFG_PATH  "./default.cfg"
#endif

static volatile int g_running = 1;

static void *watchdog_thread(void *arg)
{
    (void)arg;
    while (g_running) {
        struct timespec ts = { 0, HEARTBEAT_INTERVAL_MS * 1000000L };
        nanosleep(&ts, NULL);
    }
    return NULL;
}

typedef struct {
    int   debug;
    int   verbose;
    char *infile;
    char *cfg_file;
} app_args_t;

static int parse_args(int argc, char *argv[], app_args_t *out)
{
    int i;
    out->debug    = 0;
    out->verbose  = 0;
    out->infile   = NULL;
    out->cfg_file = DEFAULT_CFG_PATH;

    for (i = 1; i < argc; i++) {
        if (str_compare(argv[i], "-d") == 0) {
            out->debug = 1;
        } else if (str_compare(argv[i], "-v") == 0) {
            out->verbose = 1;
        } else if (str_compare(argv[i], "-c") == 0 && i + 1 < argc) {
            out->cfg_file = argv[++i];
        } else if (argv[i][0] != '-') {
            out->infile = argv[i];
        } else {
            fprintf(stderr, "Unknown option: %s\n", argv[i]);
            return -1;
        }
    }
    return out->infile ? 0 : -1;
}

int main(int argc, char *argv[])
{
    app_args_t  args;
    pthread_t   wd_tid;
    char        safe_buf[MAX_BUF_SIZE];

    if (parse_args(argc, argv, &args) != 0) {
        fprintf(stderr, "Usage: %s [-d] [-v] [-c cfg] <input>\n", argv[0]);
        return 1;
    }

    TRACE_ENTER("main");
    DBG_PRINT("cfg=%s input=%s", args.cfg_file, args.infile);

    /* SECURITY FIX: was memcpy(safe_buf, args.infile, strlen(args.infile))
     * which allowed overflow when infile length > MAX_BUF_SIZE. */
    if (safe_memcpy(safe_buf, sizeof(safe_buf),
                    args.infile, str_length(args.infile) + 1) != STATUS_OK) {
        fprintf(stderr, "Input path too long\n");
        return 1;
    }

    pthread_create(&wd_tid, NULL, watchdog_thread, NULL);
    printf("Processing: %s\n", safe_buf);
    g_running = 0;
    pthread_join(wd_tid, NULL);

    TRACE_EXIT("main");
    return 0;
}
